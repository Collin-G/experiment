# Ignore everything
*

# But not these file types
!*.py
!*.go
!*.h
!*.cpp
!*.sh
!*.txt

# PNG and SVG for documentation
!*.png
!*.svg

# Always include CMakeLists.txt files
!CMakeLists.txt

# Always include .gitignore itself
!.gitignore

# Always include README.md
!README.md

# Un-ignore all directories so their structure is kept if they contain allowed files
!*/